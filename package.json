{
  "name": "checkapet-vet-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/generate-hosted-data.mjs && node scripts/build-worker.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:generate": "node scripts/generate-hosted-data.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "vite": "^7.2.0",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
